#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [[ ! -f "$SCRIPT_DIR/.venv/Scripts/Activate.ps1" ]]; then
  echo "No encontre la .venv del proyecto en $SCRIPT_DIR/.venv/Scripts/Activate.ps1" >&2
  exit 1
fi
exec powershell.exe -NoExit -ExecutionPolicy Bypass -File "$SCRIPT_DIR/va.ps1" "$@"
